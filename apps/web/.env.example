# Só o servidor do Next fala com a API — por isso não é NEXT_PUBLIC_.
API_BASE_URL=http://localhost:3000/v1

# 'enabled' dubla a área do afiliado (/affiliate/auth e /affiliate/me) em
# memória, até essas rotas nascerem na API. O painel e o cadastro público vão
# para a API de verdade mesmo com a flag ligada.
API_MOCKING=enabled
