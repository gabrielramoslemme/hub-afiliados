# Só o servidor do Next fala com a API — por isso não é NEXT_PUBLIC_.
API_BASE_URL=http://localhost:3000/v1

# 'enabled' dubla /v1/admin e a área do afiliado (/affiliate/auth e /affiliate/me)
# em memória, até essas rotas nascerem na API. O cadastro público continua indo
# para a API de verdade mesmo com a flag ligada.
API_MOCKING=enabled
