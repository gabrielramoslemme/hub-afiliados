{
  "name": "@porto/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build && npm run verify:dist",
    "verify:dist": "! grep -rlE \"require\\\\(['\\\"]@(Domain|Infra|Application|Http|Testing)/\" dist",
    "dev": "nest start --watch",
    "start": "node dist/main",
    "type-check": "tsc --noEmit",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-e2e.json --runInBand",
    "typeorm:create": "typeorm-ts-node-commonjs migration:create src/infra/database/typeorm/migrations/$npm_config_name",
    "typeorm:generate": "typeorm-ts-node-commonjs -d ormconfig.ts migration:generate src/infra/database/typeorm/migrations/$npm_config_name",
    "typeorm:run": "typeorm-ts-node-commonjs migration:run -d ormconfig.ts",
    "typeorm:run:prod": "typeorm migration:run -d dist/infra/database/typeorm/data-source.js",
    "typeorm:revert": "typeorm-ts-node-commonjs migration:revert -d ormconfig.ts",
    "typeorm:revert:prod": "typeorm migration:revert -d dist/infra/database/typeorm/data-source.js",
    "openapi:generate": "ts-node -r tsconfig-paths/register scripts/generate-openapi.ts",
    "seed": "ts-node -r tsconfig-paths/register -r dotenv/config src/infra/database/typeorm/seeds/run-seed.ts",
    "seed:prod": "node dist/infra/database/typeorm/seeds/run-seed.js",
    "db:grants:prod": "node dist/infra/database/typeorm/grants/run-grants.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.2.3",
    "@nestjs/typeorm": "^11.0.0",
    "@porto/contracts": "*",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cpf-cnpj-validator": "^1.0.3",
    "dotenv": "^17.0.0",
    "helmet": "^8.0.0",
    "joi": "^18.0.2",
    "pg": "^8.16.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.24.0",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.28",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@porto/tsconfig": "*",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "@types/supertest": "^6.0.2",
    "jest": "^30.0.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0"
  }
}
