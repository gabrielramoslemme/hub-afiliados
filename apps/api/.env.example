NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://porto:porto@localhost:5432/hub_afiliados
# O Postgres do compose local não fala TLS. No ambiente provisionado é o
# `install-release.sh` que liga, porque o RDS roda com `rds.force_ssl = 1` e
# recusa a conexão sem TLS antes mesmo de olhar a senha.
DATABASE_SSL=false
JWT_SECRET=change-me-in-every-environment-please
# Oito horas, casado com o cookie de sessão do painel; alterar aqui sem alterar
# lá derruba a sessão no meio de uma análise.
JWT_EXPIRES_IN_SECONDS=28800
APP_BASE_URL=https://afiliados.porto.example
PANEL_BASE_URL=http://localhost:3005

# Em desenvolvimento e teste, `logger` simula o envio e registra o conteúdo.
# Em homologação e produção, use `resend`.
MAIL_PROVIDER=logger
RESEND_API_KEY=
MAIL_FROM_EMAIL=nao-responda@afiliados.porto.example
MAIL_FROM_NAME=Hub de Afiliados
