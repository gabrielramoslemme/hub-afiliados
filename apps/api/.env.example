NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://porto:porto@localhost:5432/hub_afiliados
# O Postgres do compose local não fala TLS. No ambiente provisionado é o
# `install-release.sh` que liga, porque o RDS roda com `rds.force_ssl = 1` e
# recusa a conexão sem TLS antes mesmo de olhar a senha.
DATABASE_SSL=false
JWT_SECRET=change-me-in-every-environment-please
# Oito horas, casado com o cookie de sessão do painel; alterar aqui sem alterar
# lá derruba a sessão no meio de uma análise.
JWT_EXPIRES_IN_SECONDS=28800
APP_BASE_URL=https://afiliados.porto.example
PANEL_BASE_URL=http://localhost:3005

# Em desenvolvimento e teste, `logger` simula o envio e registra o conteúdo.
# Em homologação e produção, use `resend`.
MAIL_PROVIDER=logger
RESEND_API_KEY=
MAIL_FROM_EMAIL=nao-responda@afiliados.porto.example
MAIL_FROM_NAME=Hub de Afiliados

# Integração INT-01 — cupons da Porto Serviços.
# A API sempre fala com o gateway Sensedia, e fora de `test` não sobe sem as duas
# credenciais. Em desenvolvimento, com os endereços de homologação abaixo, cada
# aprovação registra cupom de verdade lá — e o registro nunca esquece um código.
# O e2e não precisa delas: troca o gateway pelo falso antes de subir.
PORTO_OAUTH_URL=https://hml.api.portoseguro.com.br/oauth/v2/access-token
PORTO_API_BASE_URL=https://portoapicloud-hml.portoseguro.com.br
PORTO_API_BASE_PATH=/porto-assistencia/campanhasneo
PORTO_CLIENT_ID=
PORTO_CLIENT_SECRET=
# A aprovação espera esta chamada com a analista olhando para o diálogo.
PORTO_API_TIMEOUT_MS=10000

# Webhook de incentivos (INT-03) — a Porto assina cada chamada com HMAC-SHA256
# sobre "timestamp.corpo". O segredo é combinado com a Porto, um por ambiente,
# com no mínimo 32 caracteres. Vazio, a rota recusa tudo com 401.
PORTO_WEBHOOK_SECRET=
