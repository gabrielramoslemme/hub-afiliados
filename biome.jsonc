{
  "$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    // public/ guarda ativo estatico, nao fonte: o SVG da marca nao passa por
    // formatador nem pela regra de a11y de SVG, que espera JSX.
    "includes": ["**", "!**/next-env.d.ts", "!package-lock.json", "!**/public"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    },
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    }
  },
  "css": {
    "formatter": {
      "quoteStyle": "single"
    },
    // O globals.css do apps/web usa @theme, @layer e @custom-variant do Tailwind 4.
    // Sem isto o Biome trata a diretiva como erro de sintaxe e para de formatar o
    // arquivo inteiro — em silencio, com o CSS ficando de fora do quality gate.
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": {
          "level": "error",
          "options": {
            "allow": ["warn", "error"]
          }
        }
      },
      "correctness": {
        "noUnusedVariables": {
          "level": "error",
          "options": {
            "ignore": {
              "*": ["_*"]
            }
          }
        },
        "noUnusedFunctionParameters": "error"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              [":NODE:", ":PACKAGE_WITH_PROTOCOL:"],
              [":PACKAGE:", "!@porto/**"],
              "@porto/**",
              ["@Domain/**", "@Application/**", "@Infra/**", "@Http/**", "@Testing/**", "@/**"],
              ":PATH:"
            ]
          }
        }
      }
    }
  },
  // O NestJS resolve dependencia pelo metadata design:paramtypes que o
  // emitDecoratorMetadata grava. Um "import type" apaga a referencia em runtime
  // e o metadata vira [Function], quebrando a injecao sem que lint, type-check
  // ou build reclamem. Por isso useImportType fica desligado na API.
  "overrides": [
    {
      "includes": ["apps/api/**"],
      "linter": {
        // Os templates de e-mail tornaram o react dependencia da API, e com isso
        // o Biome liga o dominio React no pacote inteiro: app.useGlobalPipes()
        // passa a ser lido como hook. Nenhum componente daqui usa hook — sao
        // quatro funcoes de apresentacao —, entao o dominio nao tem o que checar.
        "domains": { "react": "none" },
        "rules": {
          "style": {
            "useImportType": "off"
          }
        }
      }
    },
    // O dominio declara contratos; quem conhece TypeORM sao os adapters em
    // src/infra/database/typeorm/repositories. Sem esta regra a inversao volta
    // a vazar no primeiro PR com pressa, e nada quebra ate alguem reparar.
    {
      "includes": ["apps/api/src/domain/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "typeorm": "The domain layer must not depend on TypeORM. Declare the contract here and implement it in src/infra/database/typeorm/repositories.",
                  "@nestjs/typeorm": "The domain layer must not depend on TypeORM. Declare the contract here and implement it in src/infra/database/typeorm/repositories."
                },
                "patterns": [
                  {
                    "group": ["@Infra/**", "@Http/**", "@Application/**"],
                    "message": "The domain layer must not import from infra, http or application. Dependencies point inwards: the outer layers implement the domain contracts."
                  }
                ]
              }
            }
          }
        }
      }
    },
    // O use case orquestra o dominio; entrega HTTP e persistencia sao de fora.
    // Nem @nestjs/common entra, e aqui nao ha excecao de *.module.ts: a classe e
    // TypeScript puro e o wiring mora em src/infra/di, porque Nest e infra. Um
    // ForbiddenException aqui amarraria a regra de negocio ao protocolo de
    // transporte.
    {
      "includes": ["apps/api/src/application/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@nestjs/common": "The application layer must not depend on Nest. Wire the use case in src/infra/di/use-cases.module.ts, and throw a DomainError instead of an HTTP exception; the filter maps it to a status.",
                  "@nestjs/swagger": "OpenAPI metadata belongs to the http layer, on the response DTO.",
                  "class-validator": "Request validation belongs to the http layer, on the request DTO.",
                  "express": "The application layer must not know about the transport.",
                  "typeorm": "The application layer talks to repository contracts, never to the ORM.",
                  "@nestjs/typeorm": "The application layer talks to repository contracts, never to the ORM."
                },
                "patterns": [
                  {
                    "group": ["@Infra/**", "@Http/**"],
                    "message": "The application layer depends on domain contracts only. Infra implements them and http calls the use case."
                  }
                ]
              }
            }
          }
        }
      }
    },
    // Infra implementa contrato do dominio. Alcancar um use case daqui inverteria
    // a seta da dependencia — a excecao e src/infra/di, cujo trabalho e
    // justamente montar o use case, e por isso fica de fora da regra.
    {
      "includes": ["apps/api/src/infra/**", "!apps/api/src/infra/di/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@Application/**", "@Http/**"],
                    "message": "Infra implements the domain contracts. Wiring the application layer is the job of src/infra/di, and http calls infra, never the other way round."
                  }
                ]
              }
            }
          }
        }
      }
    },
    // Controller conversa com use case. Alcancar o repositorio daqui pula a
    // camada onde a regra de negocio mora, e some sem deixar rastro no teste.
    // O *.module.ts fica de fora: wiring existe justamente para conhecer o
    // concreto, e e o unico arquivo do canal que pode.
    {
      "includes": ["apps/api/src/http/**", "!apps/api/src/http/**/*.module.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@Infra/database/**"],
                    "message": "The http layer must not reach the database. Call a use case in the application layer."
                  }
                ]
              }
            }
          }
        }
      }
    },
    // A web serve dois publicos que nao se encontram: o afiliado e o analista
    // da Porto. Ate aqui a separacao era so o prefixo do nome da pasta, e tres
    // imports cruzados vazaram sem lint, type-check ou build reclamarem. O
    // route group entra junto, senao a casca de rota importa o que quiser.
    //
    // ATENCAO: quando dois overrides alcancam o mesmo arquivo, o ultimo
    // SUBSTITUI a configuracao da regra, nao acrescenta a ela. Por isso o
    // padrao de barrel esta repetido nos quatro blocos em vez de morar sozinho
    // num override amplo: la ele apagaria a regra de fatia de todo arquivo de
    // apps/web/src, e o lint passaria limpo sem checar cruzamento nenhum.
    // Padrao novo aqui entra nos quatro.
    //
    // O barrel: o index.ts de cada feature e a API publica dela, e o resto e
    // interno. data.ts e session.ts sao excecao porque importam server-only —
    // reexporta-los do barrel quebraria o build no primeiro 'use client' que
    // importasse a feature, com erro apontando para o barrel e nao para a
    // causa. Import dentro da propria feature e relativo, nao passa pelo alias
    // e por isso nao e alcancado.
    {
      "includes": ["apps/web/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/*/features/*/**",
                      "!@/*/features/*/data",
                      "!@/*/features/*/session"
                    ],
                    "message": "Import the feature barrel (@/<slice>/features/<name>), its data or its session, never a file inside it."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/admin/**", "apps/web/src/app/(admin)/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/affiliate/**"],
                    "message": "The admin panel must not import from the affiliate portal. What both sides need goes to src/shared."
                  },
                  {
                    "group": [
                      "@/*/features/*/**",
                      "!@/*/features/*/data",
                      "!@/*/features/*/session"
                    ],
                    "message": "Import the feature barrel (@/<slice>/features/<name>), its data or its session, never a file inside it."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/affiliate/**", "apps/web/src/app/(affiliate)/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/admin/**"],
                    "message": "The affiliate portal must not import from the admin panel. What both sides need goes to src/shared."
                  },
                  {
                    "group": [
                      "@/*/features/*/**",
                      "!@/*/features/*/data",
                      "!@/*/features/*/session"
                    ],
                    "message": "Import the feature barrel (@/<slice>/features/<name>), its data or its session, never a file inside it."
                  }
                ]
              }
            }
          }
        }
      }
    },
    // src/shared e o fundo da pilha: quem depende dele nao pode ser sua
    // dependencia. Foi assim que a mascara de CPF acabou dentro de uma feature
    // com o painel importando de la.
    {
      "includes": ["apps/web/src/shared/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/admin/**", "@/affiliate/**", "@/app/**"],
                    "message": "src/shared must not depend on a slice. Move what it needs down into src/shared, or keep the code in the slice that owns it."
                  },
                  {
                    "group": [
                      "@/*/features/*/**",
                      "!@/*/features/*/data",
                      "!@/*/features/*/session"
                    ],
                    "message": "Import the feature barrel (@/<slice>/features/<name>), its data or its session, never a file inside it."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
